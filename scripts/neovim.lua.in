-- Endurance — Neovim
--
-- GENERATED by scripts/genpalette.py from scripts/neovim.lua.in.
-- Edit the template or the OKLCH constants, not this file.
--
-- Built on aether.nvim (the engine Omarchy already ships) with every
-- syntax and chrome group re-specified below. The rules:
--   amber   = the language itself: every reserved word, one colour
--   ember   = literal values: numbers, booleans, constants
--   blue    = functions; bold where defined, regular where called
--   glacier = types, classes, constructors, components
--   lichen  = strings
--   nebula  = the machinery: macros, decorators, builtins, escapes
--   sand    = parameters      frost = fields and properties
--   red     = errors, and nothing else
-- Chrome is flat and thin: one rule colour for every border, amber only
-- where the eye should land (cursor line number, titles, matches).

local P = {
--@PALETTE@
}

local function overrides(hl)
  local function set(groups, value)
    for _, g in ipairs(groups) do
      hl[g] = value
    end
  end

  ---------------------------------------------------------------- editor
  hl.Normal = { fg = P.fg, bg = P.bg }
  hl.NormalNC = { fg = P.fg, bg = P.bg }
  hl.NormalSB = { fg = P.fg_dim, bg = P.panel }
  hl.NormalFloat = { fg = P.fg, bg = P.panel }
  hl.FloatBorder = { fg = P.rule, bg = P.panel }
  hl.FloatTitle = { fg = P.amber, bg = P.panel, bold = true }
  hl.FloatFooter = { fg = P.comment, bg = P.panel }
  set({ "WinSeparator", "VertSplit" }, { fg = P.rule, bg = P.bg })
  hl.Cursor = { fg = P.bg, bg = P.amber }
  hl.lCursor = hl.Cursor
  hl.CursorIM = hl.Cursor
  hl.TermCursor = { fg = P.bg, bg = P.amber }
  set({ "CursorLine", "CursorColumn" }, { bg = P.cursorline })
  hl.ColorColumn = { bg = P.panel }
  set({ "LineNr", "LineNrAbove", "LineNrBelow" }, { fg = P.linenr })
  hl.CursorLineNr = { fg = P.amber, bold = true }
  hl.CursorLineSign = { bg = P.cursorline }
  hl.CursorLineFold = { fg = P.comment, bg = P.cursorline }
  hl.SignColumn = { fg = P.linenr, bg = P.bg }
  hl.SignColumnSB = { fg = P.linenr, bg = P.panel }
  hl.FoldColumn = { fg = P.linenr, bg = P.bg }
  hl.Folded = { fg = P.comment, bg = P.panel_hi, italic = true }
  hl.EndOfBuffer = { fg = P.bg }
  set({ "NonText", "Whitespace", "SpecialKey" }, { fg = P.guide_hi })
  hl.Conceal = { fg = P.comment }
  set({ "Visual", "VisualNOS" }, { bg = P.selection })
  hl.Search = { fg = P.fg_bright, bg = P.search }
  hl.IncSearch = { fg = P.void, bg = P.amber, bold = true }
  hl.CurSearch = { link = "IncSearch" }
  hl.Substitute = { fg = P.void, bg = P.orange, bold = true }
  hl.MatchParen = { fg = P.amber_bright, bg = P.match, bold = true }
  hl.QuickFixLine = { bg = P.selection, bold = true }

  hl.Pmenu = { fg = P.fg, bg = P.panel }
  hl.PmenuSel = { fg = P.fg_bright, bg = P.selection, bold = true }
  hl.PmenuMatch = { fg = P.amber, bg = P.panel, bold = true }
  hl.PmenuMatchSel = { fg = P.amber_bright, bg = P.selection, bold = true }
  hl.PmenuKind = { fg = P.cyan, bg = P.panel }
  hl.PmenuExtra = { fg = P.comment, bg = P.panel }
  hl.PmenuSbar = { bg = P.panel }
  hl.PmenuThumb = { bg = P.rule }
  hl.WildMenu = { bg = P.selection }

  hl.StatusLine = { fg = P.fg_dim, bg = P.panel }
  hl.StatusLineNC = { fg = P.muted, bg = P.panel }
  hl.WinBar = { fg = P.fg_dim, bg = P.bg, bold = true }
  hl.WinBarNC = { fg = P.muted, bg = P.bg }
  hl.TabLine = { fg = P.muted, bg = P.panel }
  hl.TabLineFill = { bg = P.void }
  hl.TabLineSel = { fg = P.fg_bright, bg = P.bg, bold = true }

  hl.Title = { fg = P.amber, bold = true }
  hl.Directory = { fg = P.blue }
  hl.Question = { fg = P.blue }
  hl.MoreMsg = { fg = P.blue }
  hl.ModeMsg = { fg = P.amber, bold = true }
  hl.MsgArea = { fg = P.fg_dim }
  hl.ErrorMsg = { fg = P.red, bold = true }
  hl.WarningMsg = { fg = P.amber, bold = true }
  hl.SpellBad = { sp = P.red, undercurl = true }
  hl.SpellCap = { sp = P.amber, undercurl = true }
  hl.SpellLocal = { sp = P.blue, undercurl = true }
  hl.SpellRare = { sp = P.magenta, undercurl = true }

  ---------------------------------------------------------------- syntax
  set({ "Comment", "SpecialComment" }, { fg = P.comment, italic = true })
  set({ "Keyword", "Statement", "Conditional", "Repeat", "Exception" }, { fg = P.amber })
  set({ "Constant", "Number", "Float", "Boolean" }, { fg = P.orange })
  set({ "String", "Character" }, { fg = P.green })
  set({ "Type", "StorageClass", "Structure", "Typedef" }, { fg = P.cyan })
  hl.Function = { fg = P.blue }
  hl.Identifier = { fg = P.fg }
  hl.Operator = { fg = P.operator }
  hl.Delimiter = { fg = P.punct }
  set({ "Special", "SpecialChar", "PreProc", "Include", "Define", "Macro", "PreCondit", "Label" },
    { fg = P.magenta })
  hl.Tag = { fg = P.blue }
  set({ "Debug", "Error" }, { fg = P.red })
  hl.Todo = { fg = P.void, bg = P.amber, bold = true }
  hl.Underlined = { underline = true }
  hl.Ignore = { fg = P.muted }

  -- names
  hl["@variable"] = { fg = P.fg }
  hl["@variable.builtin"] = { fg = P.magenta, italic = true }
  hl["@variable.parameter"] = { fg = P.param }
  hl["@variable.parameter.builtin"] = { fg = P.param, italic = true }
  set({ "@variable.member", "@property" }, { fg = P.prop })
  hl["@module"] = { fg = P.fg_dim }
  hl["@module.builtin"] = { fg = P.magenta }
  hl["@label"] = { fg = P.magenta }

  -- functions: bold at the definition site, regular at call sites
  set({ "@function", "@function.method" }, { fg = P.blue, bold = true })
  set({ "@function.call", "@function.method.call" }, { fg = P.blue })
  hl["@function.builtin"] = { fg = P.blue, italic = true }
  hl["@function.macro"] = { fg = P.magenta }
  hl["@constructor"] = { fg = P.cyan }
  hl["@constructor.lua"] = { fg = P.punct }

  -- types
  hl["@type"] = { fg = P.cyan }
  hl["@type.builtin"] = { fg = P.cyan, italic = true }
  hl["@type.definition"] = { fg = P.cyan, bold = true }
  set({ "@attribute", "@attribute.builtin" }, { fg = P.magenta })

  -- literals
  set({ "@constant", "@number", "@number.float", "@boolean", "@constant.builtin",
    "@string.special.symbol" }, { fg = P.orange })
  hl["@constant.macro"] = { fg = P.magenta }
  set({ "@string", "@character" }, { fg = P.green })
  hl["@string.documentation"] = { fg = P.docstring, italic = true }
  set({ "@string.escape", "@string.special", "@character.special" }, { fg = P.magenta })
  hl["@string.regexp"] = { fg = P.cyan }
  hl["@string.special.url"] = { fg = P.blue, underline = true }
  hl["@string.special.path"] = { fg = P.green, underline = true }

  -- the language: every reserved word is amber
  set({ "@keyword", "@keyword.coroutine", "@keyword.function", "@keyword.operator",
    "@keyword.import", "@keyword.type", "@keyword.modifier", "@keyword.repeat",
    "@keyword.return", "@keyword.debug", "@keyword.exception", "@keyword.conditional",
    "@keyword.storage", "@type.qualifier" }, { fg = P.amber })
  set({ "@keyword.directive", "@keyword.directive.define" }, { fg = P.magenta })
  hl["@keyword.conditional.ternary"] = { fg = P.operator }
  hl["@operator"] = { fg = P.operator }
  set({ "@punctuation.bracket", "@punctuation.delimiter" }, { fg = P.punct })
  hl["@punctuation.special"] = { fg = P.magenta }

  -- comments
  hl["@comment"] = { link = "Comment" }
  hl["@comment.documentation"] = { fg = P.comment, italic = true }
  hl["@comment.todo"] = { fg = P.amber, bold = true }
  hl["@comment.note"] = { fg = P.cyan, bold = true }
  hl["@comment.warning"] = { fg = P.amber_bright, bold = true }
  hl["@comment.error"] = { fg = P.red, bold = true }

  -- markup / html / jsx
  hl["@tag"] = { fg = P.blue }
  hl["@tag.builtin"] = { fg = P.blue }
  set({ "@tag.tsx", "@tag.javascript" }, { fg = P.cyan })
  hl["@tag.attribute"] = { fg = P.param }
  set({ "@tag.delimiter", "@tag.delimiter.tsx" }, { fg = P.punct })
  hl["@markup.heading"] = { fg = P.amber, bold = true }
  hl["@markup.heading.1"] = { fg = P.amber, bold = true }
  hl["@markup.heading.2"] = { fg = P.blue, bold = true }
  hl["@markup.heading.3"] = { fg = P.cyan, bold = true }
  hl["@markup.heading.4"] = { fg = P.green, bold = true }
  hl["@markup.heading.5"] = { fg = P.magenta, bold = true }
  hl["@markup.heading.6"] = { fg = P.orange, bold = true }
  hl["@markup.strong"] = { fg = P.fg_bright, bold = true }
  hl["@markup.italic"] = { italic = true }
  hl["@markup.strikethrough"] = { strikethrough = true }
  hl["@markup.underline"] = { underline = true }
  hl["@markup.quote"] = { fg = P.comment, italic = true }
  hl["@markup.math"] = { fg = P.blue }
  set({ "@markup.link", "@markup.link.label" }, { fg = P.blue })
  hl["@markup.link.url"] = { fg = P.cyan, underline = true }
  hl["@markup.raw"] = { fg = P.green }
  hl["@markup.raw.markdown_inline"] = { fg = P.green, bg = P.panel_hi }
  hl["@markup.list"] = { fg = P.amber }
  hl["@markup.list.markdown"] = { fg = P.amber, bold = true }
  hl["@markup.list.checked"] = { fg = P.green }
  hl["@markup.list.unchecked"] = { fg = P.muted }
  hl["@diff.plus"] = { fg = P.green }
  hl["@diff.minus"] = { fg = P.red }
  hl["@diff.delta"] = { fg = P.blue }

  -- LSP semantic tokens defer to treesitter where treesitter knows more
  -- (definition vs call site), and agree with it everywhere else.
  set({ "@lsp.type.function", "@lsp.type.method" }, {})
  set({ "@lsp.type.class", "@lsp.type.struct", "@lsp.type.interface", "@lsp.type.enum",
    "@lsp.type.type", "@lsp.type.typeParameter" }, { fg = P.cyan })
  hl["@lsp.type.builtinType"] = { fg = P.cyan, italic = true }
  hl["@lsp.type.enumMember"] = { fg = P.orange }
  hl["@lsp.type.property"] = { fg = P.prop }
  hl["@lsp.type.parameter"] = { fg = P.param }
  hl["@lsp.type.namespace"] = { fg = P.fg_dim }
  set({ "@lsp.type.decorator", "@lsp.type.macro" }, { fg = P.magenta })
  set({ "@lsp.type.selfKeyword", "@lsp.type.selfParameter", "@lsp.type.selfTypeKeyword" },
    { fg = P.magenta, italic = true })
  hl["@lsp.typemod.function.defaultLibrary"] = { fg = P.blue, italic = true }
  hl["@lsp.typemod.method.defaultLibrary"] = { fg = P.blue, italic = true }
  hl["@lsp.mod.deprecated"] = { strikethrough = true }

  ---------------------------------------------------------------- diagnostics
  local diag = {
    Error = { P.red, P.red_wash },
    Warn = { P.amber, P.yellow_wash },
    Info = { P.blue, P.blue_wash },
    Hint = { P.cyan, P.cyan_wash },
    Ok = { P.green, P.green_wash },
  }
  for kind, c in pairs(diag) do
    hl["Diagnostic" .. kind] = { fg = c[1] }
    hl["DiagnosticVirtualText" .. kind] = { fg = c[1], bg = c[2], italic = true }
    hl["DiagnosticVirtualLines" .. kind] = { fg = c[1] }
    hl["DiagnosticUnderline" .. kind] = { sp = c[1], undercurl = true }
    hl["DiagnosticFloating" .. kind] = { fg = c[1], bg = P.panel }
    hl["DiagnosticSign" .. kind] = { fg = c[1], bg = P.bg }
  end
  hl.DiagnosticUnnecessary = { fg = P.comment }
  hl.DiagnosticDeprecated = { sp = P.comment, strikethrough = true }
  set({ "LspReferenceText", "LspReferenceRead" }, { bg = P.ref })
  hl.LspReferenceWrite = { bg = P.ref, underline = true, sp = P.blue }
  hl.LspInlayHint = { fg = P.inlay, bg = P.inlay_bg, italic = true }
  hl.LspCodeLens = { fg = P.comment, italic = true }
  hl.LspSignatureActiveParameter = { fg = P.amber, bold = true, underline = true }
  hl.LspInfoBorder = { fg = P.rule, bg = P.panel }

  ---------------------------------------------------------------- git / diff
  hl.DiffAdd = { bg = P.diff_add }
  hl.DiffDelete = { fg = P.red, bg = P.diff_del }
  hl.DiffChange = { bg = P.diff_chg }
  hl.DiffText = { bg = P.diff_txt, bold = true }
  hl.Added = { fg = P.green }
  hl.Changed = { fg = P.blue }
  hl.Removed = { fg = P.red }
  hl.diffAdded = { fg = P.green }
  hl.diffRemoved = { fg = P.red }
  hl.diffChanged = { fg = P.blue }
  hl.diffFile = { fg = P.amber, bold = true }
  hl.diffLine = { fg = P.magenta }
  hl.GitSignsAdd = { fg = P.green }
  hl.GitSignsChange = { fg = P.blue }
  hl.GitSignsDelete = { fg = P.red }
  hl.GitSignsCurrentLineBlame = { fg = P.muted, italic = true }

  ---------------------------------------------------------------- plugins
  -- snacks (dashboard, picker, indent, notifier)
  hl.SnacksIndent = { fg = P.guide }
  hl.SnacksIndentScope = { fg = P.guide_hi }
  hl.SnacksIndentChunk = { fg = P.guide_hi }
  hl.SnacksDashboardHeader = { fg = P.amber }
  hl.SnacksDashboardIcon = { fg = P.blue }
  hl.SnacksDashboardKey = { fg = P.amber, bold = true }
  hl.SnacksDashboardDesc = { fg = P.fg }
  hl.SnacksDashboardFooter = { fg = P.comment, italic = true }
  hl.SnacksDashboardSpecial = { fg = P.magenta }
  hl.SnacksDashboardDir = { fg = P.comment }
  hl.SnacksDashboardFile = { fg = P.fg }
  hl.SnacksPicker = { fg = P.fg, bg = P.panel }
  hl.SnacksPickerBorder = { fg = P.rule, bg = P.panel }
  hl.SnacksPickerTitle = { fg = P.amber, bg = P.panel, bold = true }
  hl.SnacksPickerMatch = { fg = P.amber, bold = true }
  hl.SnacksPickerDir = { fg = P.comment }
  hl.SnacksPickerFile = { fg = P.fg }
  hl.SnacksPickerPrompt = { fg = P.amber }
  hl.SnacksPickerCursorLine = { bg = P.selection }
  hl.SnacksPickerListCursorLine = { bg = P.selection }
  hl.SnacksPickerTree = { fg = P.guide_hi }
  hl.SnacksPickerDirectory = { fg = P.blue }
  hl.SnacksPickerGitStatusModified = { fg = P.blue }
  hl.SnacksPickerGitStatusAdded = { fg = P.green }
  hl.SnacksPickerGitStatusUntracked = { fg = P.green, italic = true }
  hl.SnacksPickerGitStatusDeleted = { fg = P.red }
  hl.SnacksNotifierBorderInfo = { fg = P.rule, bg = P.panel }
  hl.SnacksNotifierTitleInfo = { fg = P.blue, bold = true }

  -- neo-tree
  hl.NeoTreeNormal = { fg = P.fg_dim, bg = P.panel }
  hl.NeoTreeNormalNC = { fg = P.fg_dim, bg = P.panel }
  hl.NeoTreeEndOfBuffer = { fg = P.panel, bg = P.panel }
  hl.NeoTreeWinSeparator = { fg = P.rule, bg = P.bg }
  hl.NeoTreeCursorLine = { bg = P.selection }
  hl.NeoTreeRootName = { fg = P.amber, bold = true }
  hl.NeoTreeDirectoryName = { fg = P.fg }
  hl.NeoTreeDirectoryIcon = { fg = P.blue }
  hl.NeoTreeFileName = { fg = P.fg_dim }
  hl.NeoTreeFileNameOpened = { fg = P.fg_bright, bold = true }
  hl.NeoTreeIndentMarker = { fg = P.guide }
  hl.NeoTreeExpander = { fg = P.muted }
  hl.NeoTreeGitAdded = { fg = P.green }
  hl.NeoTreeGitModified = { fg = P.blue }
  hl.NeoTreeGitDeleted = { fg = P.red }
  hl.NeoTreeGitUntracked = { fg = P.green, italic = true }
  hl.NeoTreeGitIgnored = { fg = P.muted }
  hl.NeoTreeGitConflict = { fg = P.orange, bold = true }
  hl.NeoTreeTitleBar = { fg = P.void, bg = P.amber, bold = true }
  hl.NeoTreeFloatBorder = { fg = P.rule, bg = P.panel }

  -- telescope
  hl.TelescopeNormal = { fg = P.fg, bg = P.panel }
  hl.TelescopeBorder = { fg = P.rule, bg = P.panel }
  hl.TelescopePromptNormal = { fg = P.fg_bright, bg = P.panel }
  hl.TelescopePromptBorder = { fg = P.rule, bg = P.panel }
  hl.TelescopePromptPrefix = { fg = P.amber }
  hl.TelescopePromptTitle = { fg = P.void, bg = P.amber, bold = true }
  set({ "TelescopeResultsTitle", "TelescopePreviewTitle" }, { fg = P.fg_dim, bg = P.panel_hi, bold = true })
  hl.TelescopeSelection = { fg = P.fg_bright, bg = P.selection }
  hl.TelescopeSelectionCaret = { fg = P.amber, bg = P.selection }
  hl.TelescopeMatching = { fg = P.amber, bold = true }

  -- which-key
  hl.WhichKey = { fg = P.amber }
  hl.WhichKeyGroup = { fg = P.blue }
  hl.WhichKeyDesc = { fg = P.fg }
  hl.WhichKeySeparator = { fg = P.muted }
  hl.WhichKeyNormal = { bg = P.panel }
  hl.WhichKeyBorder = { fg = P.rule, bg = P.panel }
  hl.WhichKeyTitle = { fg = P.amber, bg = P.panel, bold = true }
  hl.WhichKeyValue = { fg = P.comment }

  -- flash: labels in nebula so they never read as search or error
  hl.FlashLabel = { fg = P.void, bg = P.magenta, bold = true }
  hl.FlashMatch = { fg = P.fg_bright, bg = P.search }
  hl.FlashCurrent = { fg = P.void, bg = P.amber, bold = true }
  hl.FlashBackdrop = { fg = P.linenr }

  -- blink.cmp
  hl.BlinkCmpMenu = { fg = P.fg, bg = P.panel }
  hl.BlinkCmpMenuBorder = { fg = P.rule, bg = P.panel }
  hl.BlinkCmpMenuSelection = { bg = P.selection, bold = true }
  hl.BlinkCmpLabelMatch = { fg = P.amber, bold = true }
  hl.BlinkCmpLabelDetail = { fg = P.comment }
  hl.BlinkCmpLabelDescription = { fg = P.comment }
  hl.BlinkCmpLabelDeprecated = { fg = P.muted, strikethrough = true }
  hl.BlinkCmpGhostText = { fg = P.inlay, italic = true }
  hl.BlinkCmpDoc = { fg = P.fg, bg = P.panel }
  hl.BlinkCmpDocBorder = { fg = P.rule, bg = P.panel }
  hl.BlinkCmpDocSeparator = { fg = P.rule, bg = P.panel }
  hl.BlinkCmpSignatureHelp = { fg = P.fg, bg = P.panel }
  hl.BlinkCmpSignatureHelpBorder = { fg = P.rule, bg = P.panel }
  hl.BlinkCmpSignatureHelpActiveParameter = { fg = P.amber, bold = true, underline = true }
  local kinds = {
    [P.blue] = { "Function", "Method", "Constructor" },
    [P.amber] = { "Keyword", "Operator" },
    [P.cyan] = { "Class", "Struct", "Interface", "Enum", "TypeParameter", "Module" },
    [P.prop] = { "Property", "Field" },
    [P.orange] = { "Constant", "EnumMember", "Value", "Unit" },
    [P.magenta] = { "Snippet", "Event", "Reference" },
    [P.fg] = { "Variable" },
    [P.comment] = { "Text", "File", "Folder", "Color" },
  }
  for fg, names in pairs(kinds) do
    for _, n in ipairs(names) do
      hl["BlinkCmpKind" .. n] = { fg = fg }
    end
  end

  -- noice / cmdline
  hl.NoiceCmdlinePopup = { fg = P.fg, bg = P.panel }
  hl.NoiceCmdlinePopupBorder = { fg = P.rule, bg = P.panel }
  hl.NoiceCmdlinePopupTitle = { fg = P.amber, bg = P.panel, bold = true }
  hl.NoiceCmdlineIcon = { fg = P.amber }
  hl.NoiceCmdlinePopupBorderSearch = { fg = P.rule, bg = P.panel }
  hl.NoiceCmdlineIconSearch = { fg = P.amber }
  hl.NoiceConfirmBorder = { fg = P.rule, bg = P.panel }
  hl.NoiceMini = { fg = P.fg_dim, bg = P.panel }

  -- trouble, lazy, mason, bufferline
  hl.TroubleNormal = { fg = P.fg_dim, bg = P.panel }
  hl.TroubleNormalNC = { fg = P.fg_dim, bg = P.panel }
  hl.LazyH1 = { fg = P.void, bg = P.amber, bold = true }
  hl.LazyButton = { fg = P.fg_dim, bg = P.panel_hi }
  hl.LazyButtonActive = { fg = P.void, bg = P.amber, bold = true }
  hl.LazySpecial = { fg = P.amber }
  hl.MasonHeader = { fg = P.void, bg = P.amber, bold = true }
  hl.MasonHighlight = { fg = P.blue }
  hl.MasonHighlightBlockBold = { fg = P.void, bg = P.blue, bold = true }
  hl.BufferLineIndicatorSelected = { fg = P.amber }
  hl.BufferLineFill = { bg = P.void }

  -- mini.icons: same spectrum as the code
  hl.MiniIconsAzure = { fg = P.blue }
  hl.MiniIconsBlue = { fg = P.blue }
  hl.MiniIconsCyan = { fg = P.cyan }
  hl.MiniIconsGreen = { fg = P.green }
  hl.MiniIconsGrey = { fg = P.fg_dim }
  hl.MiniIconsOrange = { fg = P.orange }
  hl.MiniIconsPurple = { fg = P.magenta }
  hl.MiniIconsRed = { fg = P.red }
  hl.MiniIconsYellow = { fg = P.amber }

  -- render-markdown
  hl.RenderMarkdownCode = { bg = P.panel }
  hl.RenderMarkdownCodeInline = { fg = P.green, bg = P.panel_hi }
  hl.RenderMarkdownBullet = { fg = P.amber }
  hl.RenderMarkdownTableHead = { fg = P.rule }
  hl.RenderMarkdownTableRow = { fg = P.rule }
end

return {
  {
    "bjarneo/aether.nvim",
    branch = "v3",
    name = "aether",
    priority = 1000,
    opts = {
      styles = {
        comments = { italic = true },
        keywords = {},
        functions = {},
        variables = {},
        sidebars = "dark",
        floats = "dark",
      },
      colors = {
--@AETHER@
      },
      on_highlights = function(hl)
        overrides(hl)
      end,
    },
  },
  {
    "LazyVim/LazyVim",
    opts = {
      colorscheme = "aether",
    },
  },
}
